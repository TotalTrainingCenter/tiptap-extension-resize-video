{
  "name": "tiptap-extension-resize-video",
  "version": "1.0.0",
  "description": "A tiptap video extension: uploaded videos drop into the document as a resizable, alignable <video> node.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build:types": "tsc",
    "build": "npm run clean && npm run build:types && rollup -c",
    "dev": "npm run clean && rollup -c -w"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^24.0.1",
    "rollup": "^3.17.3",
    "rollup-plugin-auto-external": "^2.0.0",
    "rollup-plugin-sourcemaps": "^0.6.3",
    "typescript": "^4.9.5",
    "@rollup/plugin-typescript": "^11.1.6",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "tslib": "^2.6.2"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs.js",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "tiptap",
    "tiptap extension",
    "video",
    "resize-video",
    "resizable video",
    "align video"
  ]
}
